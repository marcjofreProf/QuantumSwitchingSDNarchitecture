# ---------------------------------------------------------------------------
# Quantum-SDN Switching Architecture .gitignore
# ---------------------------------------------------------------------------

# Python Virtual Environments
.venv/
venv/
env/

# Python Cache and Compiled Files
__pycache__/
*.py[cod]
*$py.class

# ---------------------------------------------------------------------------
# Downloaded installation scripts, temp archives & local clones
# ---------------------------------------------------------------------------
get-docker.sh
get_helm.sh
install_osm.sh
helm-*-linux-amd64.tar.gz
atomix-helm-charts/

# ---------------------------------------------------------------------------
# Downloaded binaries and archives
# ---------------------------------------------------------------------------
kubectl
grpcurl_*.tar.gz
grpcurl

# ---------------------------------------------------------------------------
# Keys and credentials
#
# NOTE: Do NOT ignore *.crt globally — public CA certificates such as
# onfca.crt may need to be tracked for reproducibility. Only the
# private key material is sensitive.
# ---------------------------------------------------------------------------
OSM-ETSI-Release-key.gpg
*.gpg
*.key
*.pem

# gnmic runtime config (generated by bootstrap)
.gnmic.yaml

# ---------------------------------------------------------------------------
# Standard OS hidden files
# ---------------------------------------------------------------------------
.DS_Store
*~

# ---------------------------------------------------------------------------
# Protobuf / gRPC generated Python files
#
# These are generated by the bootstrap from proto/gnmi.proto and
# proto/github.com/openconfig/gnmi/proto/gnmi_ext/gnmi_ext.proto.
# Use ** to cover all nesting levels.
# ---------------------------------------------------------------------------
proto/**/__init__.py
proto/**/*_pb2.py
proto/**/*_pb2_grpc.py
proto/**/*_pb2.pyi

# Downloaded gNMI schema files (pulled at bootstrap time)
proto/gnmi.proto
proto/github.com/
proto/github/

# ---------------------------------------------------------------------------
# Dynamically Generated µONOS Model Plugin Artifacts
#
# The tracked source of truth for the plugin is:
#   - sdn-controller/northbound-interfaces/model-plugin/controller-quantum-switching-model.yaml
#   - orchestration/yang-models/controller-quantum-switching.yang
#
# Everything below is regenerated by onosproject/model-compiler +
# `make image` on each run of register-devices.sh, and must not be tracked.
# ---------------------------------------------------------------------------
sdn-controller/northbound-interfaces/model-plugin/VERSION
sdn-controller/northbound-interfaces/model-plugin/Makefile
sdn-controller/northbound-interfaces/model-plugin/Dockerfile
sdn-controller/northbound-interfaces/model-plugin/go.mod
sdn-controller/northbound-interfaces/model-plugin/go.sum
sdn-controller/northbound-interfaces/model-plugin/*.go
sdn-controller/northbound-interfaces/model-plugin/*.tree
sdn-controller/northbound-interfaces/model-plugin/build/
sdn-controller/northbound-interfaces/model-plugin/proto/
sdn-controller/northbound-interfaces/model-plugin/api/
sdn-controller/northbound-interfaces/model-plugin/openapi/
sdn-controller/northbound-interfaces/model-plugin/plugin/
sdn-controller/northbound-interfaces/model-plugin/vendor/
sdn-controller/northbound-interfaces/model-plugin/yang/

# ---------------------------------------------------------------------------
# Locally-disabled device definitions
#
# The .disabled suffix is a convention for temporarily sidelining a device
# YAML without deleting it from the working tree.
# ---------------------------------------------------------------------------
inventory/devices/*.disabled
